# ==========================================
# Telegram OTC Bot Configuration
# ==========================================

# Required: Telegram Bot Token from @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Bot Owner Telegram numeric User IDs (comma-separated, e.g. 123456789,987654321)
# Owners can configure prompts, sponsored messages, and send broadcasts.
BOT_OWNER_IDS=

# SQLite Database file location (defaults to otc_bot.sqlite3 in project folder)
# DATABASE_PATH=otc_bot.sqlite3

# Port for cloud health check (automatically set on Render / Railway)
# PORT=10000

# ==========================================
# AI Provider Configuration (Optional)
# Gemini is preferred if GEMINI_API_KEY is provided; otherwise OpenAI is used.
# ==========================================

# Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# OpenAI API (alternative)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# ==========================================
# Custom Telegram Premium Emoji IDs (Optional)
# Provide 64-bit Telegram custom emoji IDs to display custom premium emojis in HTML messages.
# Leave blank to use professional unicode fallback emojis automatically.
# ==========================================
EMOJI_PIN_ID=           # 📌 Pin
EMOJI_UNPIN_ID=         # 📍 Unpin
EMOJI_OTC_ID=           # 🏛️ OTC Group
EMOJI_SETTINGS_ID=      # ⚙️ Settings
EMOJI_AI_ID=            # 🤖 AI
EMOJI_HELP_ID=          # ℹ️ Help
EMOJI_INFO_ID=          # 📋 Info
EMOJI_SUCCESS_ID=       # ✅ Success
EMOJI_WARNING_ID=       # ⚠️ Warning
EMOJI_ERROR_ID=         # ❌ Error
EMOJI_TIME_ID=          # ⏱️ Timer
EMOJI_ADMIN_ID=         # 🛡️ Admin
EMOJI_TOOLS_ID=         # 🛠️ Tools
EMOJI_DISMISS_ID=       # ✕ Dismiss / Cancel
EMOJI_BROADCAST_ID=     # 📢 Broadcast
EMOJI_SPONSOR_ID=       # ⭐ Sponsor
EMOJI_TOGGLE_ON_ID=     # 🟢 Toggle ON
EMOJI_TOGGLE_OFF_ID=    # 🔴 Toggle OFF
EMOJI_USER_ID=          # 👤 User
EMOJI_STATS_ID=         # 📊 Stats
EMOJI_LINK_ID=          # 🔗 Link
EMOJI_CLOCK_ID=         # ⏳ Clock / Wait
EMOJI_DELETE_ID=        # 🗑️ Delete
EMOJI_PROCEED_ID=       # ▶️ Proceed
EMOJI_BACK_ID=          # ‹ Back
EMOJI_FORWARD_ID=       # › Forward

# ==========================================
# Force Join (FSub) Configuration (Optional)
# ==========================================

# Force users to join a channel before using the bot in DM.
# Set to a @username, channel URL, or numeric channel ID.
# Leave blank to disable. Can also be configured via /fsub in the bot.
FORCE_SUB_CHANNEL=

# ==========================================
# Known OTC Group IDs for Cloud Persistence (Optional)
# ==========================================
# If running on Render Free Tier or cloud hosting with ephemeral disks,
# specify comma-separated Telegram group IDs (e.g. -1001234567890,-1009876543210).
# The bot will automatically verify and register these groups on boot every time the container starts.
KNOWN_OTC_IDS=
