# ==========================================
# Telegram OTC Bot Configuration
# ==========================================

# Required: Telegram Bot Token from @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Bot Owner Telegram numeric User IDs (comma-separated, e.g. 123456789,987654321)
# Owners can upload .txt custom AI prompt files in private chat.
BOT_OWNER_IDS=

# SQLite Database file location (optional; defaults to otc_bot.sqlite3 in project folder)
# DATABASE_PATH=otc_bot.sqlite3

# ==========================================
# AI Provider Configuration (Optional)
# Gemini is preferred if GEMINI_API_KEY is provided; otherwise OpenAI is used.
# ==========================================

# Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# OpenAI API (alternative)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# ==========================================
# Custom Telegram Emoji IDs (Optional)
# Provide 64-bit Telegram custom emoji IDs to display custom animated/premium emojis in HTML messages.
# Leave blank to use professional unicode fallback emojis automatically.
# ==========================================
EMOJI_PIN_ID=
EMOJI_UNPIN_ID=
EMOJI_OTC_ID=
EMOJI_SETTINGS_ID=
EMOJI_AI_ID=
EMOJI_HELP_ID=
EMOJI_SUCCESS_ID=
EMOJI_WARNING_ID=
EMOJI_ERROR_ID=
EMOJI_TIME_ID=
EMOJI_ADMIN_ID=
EMOJI_TOOLS_ID=
